{
  "name": "krustentv-bot",
  "version": "1.0.0",
  "description": "Discord-Bot für automatische YouTube-Video-Sammlung und Watch2Gether-Integration",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "smoke": "node scripts/smoke.js",
    "w2g:check": "node scripts/w2g_check.js"
  },
  "keywords": [
    "discord",
    "bot",
    "youtube",
    "watch2gether"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "acorn": "^8.15.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "jest": "^29.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
