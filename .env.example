# Example environment file for KRUSTENTV-BOT
# Copy this file to .env and replace the placeholders with real values.

# Discord: Bot token from the Discord Developer Portal under "Anwendung" > "Bot" > "Token"
DISCORD_TOKEN=your_discord_bot_token
# Discord: Application ID from the Developer Portal under "Anwendung" > "Allgemeine Informationen"
DISCORD_CLIENT_ID=your_discord_client_id
# Optional: Server ID (Guild ID) for testing the bot in one specific Discord server only
DISCORD_GUILD_ID=your_discord_guild_id

# YouTube: API key from Google Cloud Console > APIs & Services > Credentials
YOUTUBE_API_KEY=your_youtube_api_key

# Watch2Gether: API key and room ID from your Watch2Gether account or room settings
W2G_API_KEY=your_w2g_api_key
W2G_ROOM_ID=your_w2g_room_id
# Set to true to skip real Watch2Gether POST requests while still allowing dry-run testing
W2G_DRY_RUN=false
# Set to true to force live pushes even when dry-run would otherwise prevent them
W2G_FORCE_LIVE=false
# Set to true to print additional Watch2Gether debug output
W2G_DEBUG=false

# Optional: only consider videos published on or after this ISO-8601 timestamp
MIN_VIDEO_PUBLISHED_AT=2026-01-01T00:00:00Z

# Optional: sample channel input used by the smoke script
SMOKE_CHANNEL_INPUT=https://www.youtube.com/channel/UC_example
