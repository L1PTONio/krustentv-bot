# Example environment file for KRUSTENTV-BOT
# Copy this file to .env and replace the placeholders with real values.

# Runtime
# Optional: defaults to development when empty or unset
NODE_ENV=development

# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
# Optional: Server ID (Guild ID) for testing in one specific Discord server only
DISCORD_GUILD_ID=your_discord_guild_id

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
# Optional: request timeout in milliseconds (default: 10000)
YOUTUBE_REQUEST_TIMEOUT_MS=10000

# Watch2Gether
W2G_API_KEY=your_w2g_api_key
W2G_ROOM_ID=your_w2g_room_id
# Set to true to skip real Watch2Gether POST requests while still allowing dry-run testing
W2G_DRY_RUN=false
# Set to true to force live pushes even when dry-run would otherwise prevent them
W2G_FORCE_LIVE=false
# Optional: request timeout in milliseconds (default: 10000)
W2G_REQUEST_TIMEOUT_MS=10000
# Optional: minimum delay between Watch2Gether requests in milliseconds (default: 1000)
W2G_MIN_REQUEST_INTERVAL_MS=1000
# Set to true to print additional Watch2Gether debug output
W2G_DEBUG=false

# Optional: persistence and runtime defaults
# Empty values fall back to the built-in defaults
DATABASE_PATH=data/krustentv.sqlite
# Optional: only consider videos published on or after this ISO-8601 timestamp
MIN_VIDEO_PUBLISHED_AT=2026-01-01T00:00:00Z
# Optional: comma-separated Discord user IDs with elevated admin access
ADMIN_USER_IDS=
# Optional: comma-separated Discord role IDs with elevated admin access
ADMIN_ROLE_IDS=
# Optional: allow all members to use admin features (default: false)
ADMIN_ALLOW_ALL_MEMBERS=false
# Optional: session TTL in minutes (default: 60)
SESSION_TTL_MINUTES=60

# Optional: sample channel input used by the smoke script
SMOKE_CHANNEL_INPUT=https://www.youtube.com/channel/UC_example
